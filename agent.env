# The rentals agent. Deployment comes from plow-pbc/agent-mgr; this file is the
# only thing that makes it this agent rather than another.
#
# Both name overrides are legacy: this agent predates the ~/.hermes-<name>
# convention and its home and container carry no suffix. Renaming either would
# mean moving live state -- auth.json, sessions, the Hostex poll cursor -- out
# from under a running gateway, which is a larger change than this one and buys
# nothing the convention is for.
AGENT_HOME=$HOME/.hermes
AGENT_CONTAINER=hermes
AGENT_PROJECT=hermes-str

# This repo is the build context for the derived image and the source of the
# scripts the scheduler runs. The DEPLOY clone, never a dev checkout: code is
# written in ~/Hacking and runs from ~/services, and a runtime aimed at the
# former goes stale or breaks the first time the branch moves.
STR_REPO=$HOME/services/sams-str-hermes-agent
STR_VAULT=$HOME/hermes-vault

# Built here rather than pulled: the Dockerfile adds obsidian-wiki and the OKF
# validator on top of the pinned upstream image, so this agent does not use
# agent-mgr's fleet-wide digest directly.
AGENT_IMAGE=sams-str-hermes-agent:local

# This agent keeps its declarative config under runtime/, beside the vault seed
# and the SOUL persona it ships with. Naming it here is what lets `agent-mgr
# deploy str` work -- without it this repo kept a second installer that
# hardcoded both this path and the home, which is two owners of the one thing
# agent-mgr exists to own.
AGENT_CONFIG=runtime/config.yaml

# Stated rather than inherited. agent-mgr defaults to this zone, but every
# schedule in this repo is a Pacific wall-clock expression -- `0 3 * * *` fires
# at 8 PM Pacific under UTC, during peak guest messaging, which is the one
# window the nightly chain exists to avoid. One owner, in the repo that owns
# the schedules.
AGENT_TZ=America/Los_Angeles

# This gateway is live for the owners: a transition drops group subscriptions
# until the next reconcile, and risks what AGENT_PRE_TRANSITION's guard
# documents. That guard vetoes one known-bad window; this makes every
# transition ask [y/N] first. Automation that means it passes
# AGENT_TRANSITION_ACK=1.
AGENT_LIVE=1

# This agent's own deploy step, which `agent-mgr deploy str` runs after its
# own installs: the vault seed, the hub rebuild and the composed SOUL. Declared
# here so ONE command is the whole deploy -- the alternative, agent-mgr doing
# its half and the README telling the operator to run the rest in order, moves
# ownership to whoever reads the docs.
AGENT_DEPLOY_HOOK=scripts/restore-runtime-config.sh

# This agent vetoes a container transition while a nightly ingest is running.
# agent-mgr invokes it before every one, so no documented sequence restates it.
AGENT_PRE_TRANSITION=scripts/no-nightly-running
