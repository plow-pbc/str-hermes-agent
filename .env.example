# Required secrets. Restore from the named provider; never commit values.
HOSTEX_TOKEN=
PLOW_CHAT_TOKEN=
# Seam Console → Settings → API Keys. Scoped to one workspace, so it must be
# the workspace the locks are connected to.
SEAM_API_KEY=
# Plow Latch pair for the operator's Mac. Minted in Latch (Agents -> create
# a static credential) and written by `agent-mgr set-latch str`.
DOMO_DEVICE_UID=
DOMO_MCP_TOKEN=

# Required Plow chat configuration.
PLOW_CHAT_CHAT_UID=

# The owners' group that receives guest-reply drafts and whose members can
# approve them. Its display name from PLOW_CHAT_GROUP_UIDS below.
PLOW_CHAT_APPROVAL_GROUP=

# Optional trusted Plow groups, comma-separated `<cht_ id>=<display name>`.
# The name is what the agent sees and what send_message resolves for
# `plow_chat:#<name>`; a group's standing prompt is keyed by it in
# runtime/config.yaml under platforms.plow_chat.extra.group_prompts.
PLOW_CHAT_GROUP_UIDS=
