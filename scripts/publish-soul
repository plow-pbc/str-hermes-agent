#!/usr/bin/env bash
# Compose and publish the injected SOUL.md into $HERMES_HOME. Runs on the HOST.
#
# SOUL.md is auto-injected into every agent turn (see `hermes --help`: "Skip
# auto-injection of AGENTS.md, SOUL.md"), which makes it the one seam where
# fact-awareness is guaranteed once rather than per-path -- the poller prompt,
# the cron prompts and interactive chat all inherit it. Composed from the
# tracked persona (runtime/SOUL.md) plus the vault's index -- the index, not
# the pages: the whole vault is ~61k tokens and the index ~1.7k. The index
# says what exists; the turn that is already running opens the page it needs,
# which is a better retrieval decision than any made in advance.
#
# The base image hardens the injected identity: plow-init's harden_home() sets
# $HERMES_HOME/SOUL.md to root:root 0644 inside a root-owned STICKY home, at
# every container start, so the agent cannot rewrite what it is. That also puts
# the file out of reach of the operator -- a sticky directory lets only the
# file's owner replace it, and after the first boot that owner is root. So the
# nightly (hermes, in the container) cannot publish, and neither can a plain
# host write; the one actor that can is root, and the host reaches root through
# the container without a password.
#
# Composed here, never copied from a staged file. The persona half comes from
# runtime/SOUL.md, which the container mounts READ-ONLY; the index half comes
# from the vault, which the agent writes. Installing an agent-authored file as
# root would hand the agent the persona too -- the exact thing harden_home()
# exists to prevent.
#
# Lands root:root 0644: harden_home()'s own target, so the next boot's fchown
# and fchmod change nothing rather than changing this back.
#
#   scripts/publish-soul [vault]
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# AGENT_HOME and AGENT_CONTAINER, filled from agent.env when this process does
# not already have them -- an agent-mgr-driven run exports both and must win.
# Needed because the 04:30 cron line has neither: `cd
# ~/services/sams-str-hermes-agent && ./scripts/promote-vault`, no agent-mgr,
# no env file, and neither var is exported even in the operator's own
# interactive shell. Without this, every run against an already-hardened
# target reached AGENT_CONTAINER's `:?` below and died -- silently as far as
# the corpus push above it was concerned, since that had already succeeded.
#
# agent.env is agent-mgr's single owner of these two names -- read from it
# rather than inventing a second default that could drift from it. Sourced in
# a subshell, never directly: agent.env unconditionally assigns both, and
# sourcing it into this shell would clobber an agent-mgr-driven run's real
# values with its own. `.`, not a grep or sed: agent.env is KEY=value with
# `$HOME` references and comments, meant to be sourced -- a text scrape would
# return the literal string `$HOME/.hermes`, not the real path. A missing or
# unreadable agent.env leaves the two empty here rather than aborting, because
# an agent-mgr-driven run that already has both exported does not need this
# file to exist at all; the `:?` guards below are what make the truly-
# undetermined case loud.
eval "$(
    . "$repo_root/agent.env" 2>/dev/null || true
    printf 'agent_env_home=%q\n' "${AGENT_HOME-}"
    printf 'agent_env_container=%q\n' "${AGENT_CONTAINER-}"
)"
: "${AGENT_HOME:=$agent_env_home}"
: "${AGENT_CONTAINER:=$agent_env_container}"

vault="${1:-${STR_VAULT:-$HOME/hermes-vault}}"
home="${AGENT_HOME:?publish-soul: could not determine AGENT_HOME -- not exported and not declared in $repo_root/agent.env}"
target="$home/SOUL.md"
persona="$repo_root/runtime/SOUL.md"
index="$vault/index.md"

# Fail rather than emit a partial SOUL, before the target is touched. A SOUL
# missing its index is an agent that believes it has no memory and says so
# confidently -- the quietest failure this repo can ship, because nothing
# downstream reads as broken.
[ -f "$persona" ] || { echo "publish-soul: no persona at $persona" >&2; exit 1; }
[ -f "$index" ]   || { echo "publish-soul: no index at $index" >&2; exit 1; }

# The index comes from the agent's own writable vault, and this script's
# output is a root-owned, auto-injected file -- so a symlink here reads a host
# file straight into the agent's context. `index.md -> ../.ssh/id_ed25519`
# resolves to nothing inside the container and to the operator's private key
# on the host, which this script would then publish to ~/.hermes/SOUL.md as
# root.
#
# Refused at the open, not by a test before it. `[ -L ]` then `cat` is two
# steps with the agent writing between them: a loop alternating the index
# between a real file and a link wins that race on roughly every other
# deploy, and the losing half only produces a refusal the operator may not
# read. Opening with O_NOFOLLOW makes the check and the read the same
# operation.
read_index() {
    python3 -c 'import os, sys, shutil
try:
    fd = os.open(sys.argv[1], os.O_RDONLY | os.O_NOFOLLOW)
except OSError as e:
    sys.exit(f"publish-soul: refusing to read {sys.argv[1]}: {e.strerror}")
shutil.copyfileobj(os.fdopen(fd, "rb"), sys.stdout.buffer)' "$1"
}

# Composed into the home, so the mv below is a same-filesystem rename when the
# direct path applies. umask 077 while it is a temp file: it carries the
# operator's whole index, and it is only widened to 0644 at the rename. One
# write straight into $staged rather than a second internal write-then-rename:
# $staged is already a scratch file no reader consumes until the mv/docker-exec
# steps below promote it, so an interrupted write here leaves at worst an
# orphaned temp file, never a partial live SOUL -- bash cannot begin those
# later steps until this compound redirect has completed.
umask 077
staged="$(mktemp "$target.XXXXXX")"
trap 'rm -f "$staged"' EXIT
{
    cat "$persona"
    printf '\n'
    read_index "$index"
} > "$staged"

# Idempotent and quiet, like promote-vault: this runs from cron every night
# whether or not the corpus moved, and a rewrite that changes no bytes still
# costs a gateway prompt-cache miss on the next turn.
if [ -f "$target" ] && cmp -s "$staged" "$target"; then
    echo "publish-soul: already current"
    exit 0
fi

# The direct path first, established rather than inferred from a failing
# write: a home whose SOUL.md this user can still replace -- a fresh deploy
# before the agent's first boot, and every test -- needs no container at all.
#
# chmod then mv, not install(1) and not a `>`/`>>` redirect. Not the redirect:
# fs.protected_regular=2 (verified on the live host) makes the kernel refuse a
# redirect's open of an existing file in a sticky directory when the opener is
# not that file's owner. Not install(1) either: it unlinks the destination and
# writes a new inode in place, which is not atomic from the gateway's point of
# view -- a process killed mid-write leaves the LIVE SOUL truncated, an agent
# with no instructions, the exact worst case this whole change exists to
# avoid. `mv` within the same directory is a rename: the path always resolves
# to either the complete old file or the complete new one, never a partial
# one, and `staged` already lives in $home (the mktemp above), so this really
# is a same-filesystem rename rather than a cross-device copy.
#
# Stderr captured rather than discarded: if this fails for a reason other than
# "hardened" (a missing directory, a full disk), the fallback below is not the
# right diagnosis, and $direct_err is what lets the eventual failure say what
# actually happened instead of assuming.
if direct_err=$(chmod 644 "$staged" && mv "$staged" "$target" 2>&1); then
    echo "publish-soul: published $target"
    exit 0
fi

# Otherwise the file is hardened and only root can replace it. Same container
# resolution as scripts/no-nightly-running: not-running is established up front,
# because "it is not up" and "the check could not run" are the same non-zero
# status from exec and only one of them has a safe next step.
container="${AGENT_CONTAINER:?publish-soul: could not write $target directly ($direct_err), and AGENT_CONTAINER could not be determined -- not exported and not declared in $repo_root/agent.env -- run me through agent-mgr, or start the agent}"
running=$(docker ps -q --filter "name=^${container}$" --filter status=running) || {
    echo "FATAL: could not ask docker whether ${container} is running" >&2
    exit 1
}

# The write sequence, shared by both root paths below: mktemp INSIDE the
# home directory (never a container's default tmpdir), so the mv that
# follows is a same-filesystem rename and therefore atomic; chown+chmod
# happen before that mv, so the rename lands the file at its final identity
# in one step rather than widening permissions on a path already visible
# under its live name. Root permits the rename despite the sticky bit
# regardless of who owns the file today.
#
# $1 if given -- the running-container path below already queried it from
# the very container it is about to exec back into. Otherwise $HERMES_HOME
# resolved natively: the stopped-container path boots a fresh container from
# the same image, which already has it set, with no running instance to
# query first.
publish_as_root='
    set -eu
    home="${1:-${HERMES_HOME:?publish-soul: HERMES_HOME is empty inside the container -- refusing to publish to its filesystem root}}"
    tmp=$(mktemp "$home/SOUL.md.XXXXXX")
    trap "rm -f \"$tmp\"" EXIT
    cat > "$tmp"
    chown root:root "$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$home/SOUL.md"
'

if [ -n "$running" ]; then
    # $HERMES_HOME read from the container rather than assumed, and guarded
    # the way bin/nightly.sh guards its own: printenv exits 0 for a
    # set-but-empty variable, and an empty value below would resolve
    # "$1/SOUL.md" to /SOUL.md -- the container's filesystem root -- while
    # still printing success.
    hermes_home=$(docker exec "$container" printenv HERMES_HOME) || {
        echo "FATAL: could not read HERMES_HOME from ${container}" >&2
        exit 1
    }
    hermes_home="${hermes_home:?publish-soul: HERMES_HOME is set but empty inside ${container} -- refusing to publish to its filesystem root}"

    docker exec -u root -i "$container" sh -c "$publish_as_root" _ "$hermes_home" < "$staged" || {
        echo "FATAL: could not publish the SOUL into ${container} ($hermes_home)" >&2
        exit 1
    }
    echo "publish-soul: published $target as root:root 0644"
    exit 0
fi

# ${container} exists but is stopped -- cron cannot start it (the 04:30
# promote's crontab line has no agent-mgr on PATH at all, verified: `env -i
# PATH=/usr/bin:/bin sh -c 'command -v agent-mgr'` finds nothing there), so
# this branch is for the deploy/interactive path's recovery, where a
# previously-booted-then-stopped agent still has a hardened target only root
# can replace and there is no running container left to exec into.
#
# `agent-mgr compose ... run --rm`, never `docker compose` directly: it owns
# the compose file list, the override and the env-file, and reaching for
# `docker compose` here would restate all three and drift from the real
# deployment -- the exact form justfile's test-wiki recipe already uses for
# the same reason. Boots a throwaway container from the same image and
# config, runs the shared write sequence above as root inside it (--user
# 0:0), and exits -- one-shot, no lasting side effect beyond the file it
# wrote.
if command -v agent-mgr >/dev/null 2>&1; then
    agent-mgr compose str run --rm --no-deps -T --user 0:0 \
        --entrypoint bash hermes -c "$publish_as_root" < "$staged" || {
        echo "FATAL: could not publish the SOUL through agent-mgr (${container} is stopped)" >&2
        exit 1
    }
    echo "publish-soul: published $target as root:root 0644 (via agent-mgr, ${container} was stopped)"
    exit 0
fi

echo "FATAL: could not write $target directly ($direct_err), ${container} is not running, and agent-mgr is not on PATH." >&2
echo "  Start the agent and re-run this script, or run this through agent-mgr, or start it interactively." >&2
exit 1
