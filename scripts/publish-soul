#!/usr/bin/env bash
# Install runtime/SOUL.md as the agent's persona, from the host, without a rebuild.
#
# The image bakes the same file and docker/cont-init.d/05-install-agent-payload.sh
# reinstalls it on every boot, so this is a stopgap for an edit that must land
# now -- the durable change is runtime/SOUL.md plus `docker compose build`. The
# next boot overwrites whatever this wrote, which is the intended direction: the
# image is canonical.
#
# The vault index is deliberately not in the persona. plow-init treats SOUL.md as
# provisioned identity and freezes it root:root 0644 at every start, so the SOUL
# names $HERMES_HOME/repo/vault/index.md and tells the agent to read it; the
# nightly keeps that file current in the vault it already owns. Identity stays
# frozen, knowledge stays live, and neither needs machinery to reach the other.
#
#   scripts/publish-soul
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source_soul="$repo_root/runtime/SOUL.md"

# Compose resolves its project from the directory, so anchor it to this repo
# rather than to the caller's cwd: run from elsewhere, a bare `docker compose`
# names a different project -- a dev checkout of this same repo is one -- and
# publishes into a container that is not this agent.
compose() { docker compose --project-directory "$repo_root" "$@"; }

# -s, not -f: an empty persona publishes an agent with no instructions, which
# reads like a healthy deploy and is the quietest failure this repo can ship.
[ -s "$source_soul" ] || { echo "publish-soul: no persona at $source_soul" >&2; exit 1; }

# Everything happens inside the container. There is no host path to write: the
# home is a named volume, and the only supported way in is the container that
# mounts it. That also settles what used to be a two-branch script -- a direct
# host write, falling back to an escalated exec once plow-init had taken the
# file. The first branch cannot succeed against a volume, so it is gone rather
# than kept as a path that only ever fails.
#
# The compare runs in here too, for the same reason, and it is not just tidiness:
# the persona changes on the rare edit, so the normal case is that there is
# nothing to do, and a rewrite that changes no bytes still costs the gateway a
# prompt-cache miss on its next turn.
#
# mktemp inside $HERMES_HOME, not the container's default tmpdir: a rename is
# only atomic within one filesystem. `:?` on HERMES_HOME -- unset or empty would
# otherwise publish to the container's filesystem root. chown and chmod before
# the mv, so the file arrives at its final identity in one step rather than
# being widened after it is already live under that name.
#
# chmod then mv, never a `>` redirect and never install(1). Not the redirect:
# fs.protected_regular=2 makes the kernel refuse to open an existing file in a
# sticky directory when the opener is not its owner. Not install(1): it unlinks
# the destination and writes a new inode in place, so a process killed mid-write
# leaves the LIVE SOUL truncated. `mv` within one directory is a rename -- the
# path resolves to the whole old file or the whole new one, never a partial.
#
# No `docker ps` preflight: unlike scripts/no-nightly-running, where not-running
# is a pass that must be told apart from "the check could not run", here
# not-running is a failure either way and compose already exits non-zero with
# its own stderr saying so.
status=0
compose exec -u root -T hermes sh -c '
    set -eu
    home="${HERMES_HOME:?publish-soul: HERMES_HOME is unset or empty inside the container}"
    tmp=$(mktemp "$home/SOUL.md.XXXXXX")
    trap "rm -f \"$tmp\"" EXIT
    cat > "$tmp"
    if [ -f "$home/SOUL.md" ] && cmp -s "$tmp" "$home/SOUL.md"; then
        echo "publish-soul: already current"
        exit 3
    fi
    chown root:root "$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$home/SOUL.md"
    echo "publish-soul: published $home/SOUL.md as root:root 0644"
' < "$source_soul" || status=$?

# 3 is the no-op the inner shell reports, not a failure. Anything else is.
[ "$status" -eq 0 ] || [ "$status" -eq 3 ] || {
    echo "FATAL: could not publish the SOUL" >&2
    exit 1
}
