#!/opt/hermes/.venv/bin/python3
"""setup-discover <command> -- read-only lookups that print JSON, so setup can
offer choices instead of asking for IDs. Exit 2 and one sentence on stderr on failure.

  latch | hostex-properties | seam-devices | seam-codes <seam_device_id>

Secrets come from bin/str_env.py over the process environment, never argv.
Hostex goes through hostex_api.get, with its retries for the daily stalls.
Seam is called over REST, not the SDK: `seam` lives only in the mcp-seam uv
environment, not in this interpreter: fetch(url, headers) -> dict, over
hostex_api's no-redirect opener.
"""
from __future__ import annotations

import json, os, pathlib, sys
import urllib.error, urllib.parse, urllib.request

BIN = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(BIN))
import hostex_api  # noqa: E402
import str_env  # noqa: E402

SEAM = "https://connect.getseam.com"
PAGE = 100


def fetch(url: str, headers: dict) -> dict:
    request = urllib.request.Request(url, headers={"User-Agent": "str-setup-discover/1", "Accept": "application/json", **headers})
    with hostex_api.OPENER.open(request, timeout=hostex_api.TIMEOUT_S) as response:
        return json.loads(response.read().decode())


class Owner(Exception):
    """A failure with a sentence the owner can act on."""


def _secret(env, key):
    if not env.get(key, "").strip():
        raise Owner(f"{key} is not set; run setup to store it first.")
    return env[key].strip()


def cmd_latch(env, fetch):
    return {"configured": bool(env.get("PLOW_MCP_URL", "").strip())}


def cmd_hostex_properties(env, fetch):
    token = _secret(env, "HOSTEX_TOKEN")
    found, offset = [], 0
    while True:
        batch = hostex_api.get("/properties", token, "str-setup-discover/1",
                               offset=offset, limit=PAGE)["data"]["properties"]
        found += batch
        if len(batch) < PAGE:
            break
        offset += PAGE
    return [{"hostex_property_id": p["id"], "title": p.get("title") or "",
             "timezone": p.get("timezone"), "default_checkin_time": p.get("default_checkin_time")}
            for p in found]


def _seam_get(env, fetch, path, **params):
    headers = {"Authorization": "Bearer " + _secret(env, "SEAM_API_KEY")}
    return fetch(f"{SEAM}{path}?{urllib.parse.urlencode(params)}", headers)


def cmd_seam_devices(env, fetch):
    # mcp-seam's list_locks is client.locks.list() -> /locks/list
    return [{"seam_device_id": d["device_id"], "name": (d.get("properties") or {}).get("name") or ""}
            for d in _seam_get(env, fetch, "/locks/list")["devices"]]


def cmd_seam_codes(env, fetch, device_id):
    # Both of Seam's disjoint collections, as mcp-seam's _all_codes reads them.
    codes = [c for path in ("/access_codes/list", "/access_codes/unmanaged/list")
             for c in _seam_get(env, fetch, path, device_id=device_id)["access_codes"]]
    codes.sort(key=lambda c: (c.get("name") or "").casefold())
    return [{"access_code_id": c["access_code_id"], "name": c.get("name") or ""} for c in codes]


COMMANDS = {"latch": cmd_latch, "hostex-properties": cmd_hostex_properties,
            "seam-devices": cmd_seam_devices, "seam-codes": cmd_seam_codes}
SERVICE = {"hostex-properties": "Hostex", "seam-devices": "Seam", "seam-codes": "Seam"}


def main(argv, environ=None, fetch=fetch):
    environ = os.environ if environ is None else environ
    name, args = (argv[0] if argv else ""), argv[1:]
    if name not in COMMANDS or len(args) != (name == "seam-codes"):
        print("setup-discover: usage: setup-discover latch | hostex-properties | seam-devices "
              "| seam-codes <seam_device_id>", file=sys.stderr)
        return 2
    service = SERVICE.get(name, "setup")
    try:
        home = pathlib.Path(environ.get("HERMES_HOME", "/var/lib/hermes"))
        env = {**environ, **str_env.read_setup_env(home)}
        result = COMMANDS[name](env, fetch, *args)
    except Owner as e:
        print(f"setup-discover: {e}", file=sys.stderr)
        return 2
    except urllib.error.HTTPError as e:
        if e.code == 401:
            print(f"setup-discover: {service} rejected the token; check the key you gave setup.", file=sys.stderr)
        else:
            print(f"setup-discover: {service} refused the request (HTTP {e.code}).", file=sys.stderr)
        return 2
    except (KeyError, ValueError):
        print(f"setup-discover: {service} answered something unexpected.", file=sys.stderr)
        return 2
    except OSError:
        print(f"setup-discover: could not reach {service}; check the network and try again.", file=sys.stderr)
        return 2
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
