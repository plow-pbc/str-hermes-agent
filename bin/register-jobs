#!/opt/hermes/.venv/bin/python3
"""register-jobs [--boot] -- reconcile str's Hermes cron jobs with its config.

Runs inside the container: at boot (06-register-jobs, as the gateway's user) and
by hand (`docker compose exec -u hermes hermes
/opt/plow/str/bin/register-jobs`). Shaped like life-assistant's register_crons.py:
it reads jobs.json, hermes's own state, rather than parsing `hermes cron list`,
and only a missing file means "nothing registered" -- reading an unreadable one
as empty would duplicate every job. Only the names in OWNED and RETIRED are
touched; every job is CLI-created with origin null.

--boot never fails the boot: before setup it says so and exits 0, and any other
error is printed and exits 0. Without it, errors exit 1 for setup to report.
"""
from __future__ import annotations

import argparse, json, os, pathlib, subprocess, sys, tomllib

BIN = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(BIN))
import str_env

HERMES = "/opt/hermes/bin/hermes"
HOME = "plow_chat"  # bare: the platform's home channel, the operator's direct chat
OWNED = ("hostex-inbound", "wiki-nightly", "turnover")
RETIRED = ("checkin-watch",)  # removed wherever an older image registered it


def _job(name, schedule, script):
    # No agent turn: each script hands its owners' turn to the plugin's wake
    # inbox itself, so its own output is only ever a failure, the operator's.
    return {"name": name, "schedule": schedule, "script": script, "deliver": HOME, "no_agent": True}


def desired_jobs(env, ops):
    str_env.approval_group(env)  # a group label naming no group refuses here, not at a tick
    # hostex-poll hands its drafts to the owners' session, which holds what they
    # said; turnover-poll wakes each step's own thread. The digest is the
    # operator's: nightly.sh's stdout is vault text distilled from guest mail,
    # so it never enters a prompt.
    jobs = [_job("hostex-inbound", "every 2m", "hostex-poll.py"),
            _job("wiki-nightly", "0 3 * * *", "nightly.sh")]
    properties = ops.get("properties", [])
    threads = {p[k] for p in properties for k in ("cleaners_thread", "maintenance_thread")}
    if env.get("SEAM_API_KEY") and properties and threads <= set(str_env.groups(env)):
        jobs.append(_job("turnover", "every 2m", "turnover-poll.py"))
    return jobs


def registered_jobs(jobs_path):
    """{name: job} from jobs.json. Subscripted, not .get: a missing field is loud."""
    try:
        return {job["name"]: job for job in json.loads(pathlib.Path(jobs_path).read_text())["jobs"]}
    except FileNotFoundError:
        return {}


def reconcile(desired, registered):
    want = {job["name"]: job for job in desired}
    actions = []
    for name in OWNED + RETIRED:
        job, have = want.get(name), registered.get(name)
        if name in OWNED and have is not None and (not have["enabled"] or have["paused_at"]):
            print(f"register-jobs: {name} is paused -- left alone, never duplicated; "
                  f"resume it: hermes cron resume {name}")
        elif have is None:
            if job:
                actions.append(("create", job))
        elif job is None:
            actions.append(("remove", name))
        elif ((have["schedule"]["display"], have["deliver"], have["script"], have["no_agent"])
              != (job["schedule"], job["deliver"], job["script"], job["no_agent"])):
            actions.append(("replace", job))
    return actions


def create_argv(job):
    return [HERMES, "cron", "create", job["schedule"], "--name", job["name"],
            "--script", job["script"], "--no-agent", "--deliver", job["deliver"]]


def cursor_path(home):
    return pathlib.Path(home) / "hostex-poll-cursor.json"


def _run(argv):
    # A run from a setup turn must not stamp that turn's session as the origin.
    inherited = {k: v for k, v in os.environ.items() if not k.startswith("HERMES_SESSION_")}
    try:
        return subprocess.run(argv, capture_output=True, text=True, env=inherited, timeout=120)
    except subprocess.TimeoutExpired as exc:
        out = (exc.stdout or b"").decode(errors="replace")  # bytes even with text=True
        return subprocess.CompletedProcess(argv, 124, out, f"timed out after {exc.timeout:g}s")


def _check(runner, argv):
    proc = runner(argv)
    if proc.returncode != 0:
        raise SystemExit(f"register-jobs: {' '.join(argv[:4])} failed:\n{proc.stdout}{proc.stderr}")


def _load_ops(path):
    try:
        return tomllib.loads(path.read_text())
    except FileNotFoundError:
        return {}


def apply(env, runner):
    home = pathlib.Path(env.get("HERMES_HOME", "/var/lib/hermes"))
    ops = _load_ops(pathlib.Path(env.get("VAULT") or home / "repo/vault") / "ops.toml")
    registered = registered_jobs(home / "cron/jobs.json")
    for kind, x in reconcile(desired_jobs(env, ops), registered):
        name = x if kind == "remove" else x["name"]
        if kind != "create":
            _check(runner, [HERMES, "cron", "remove", registered[name]["id"]])
        if kind != "remove":
            try:
                # Prime only a cold cursor: the first tick would otherwise adopt
                # whatever arrived meanwhile, and priming a warm one retires a guest.
                if name == "hostex-inbound" and not cursor_path(home).exists():
                    _check(runner, [str(BIN / "hostex-poll.py")])
                _check(runner, create_argv(x))
            except SystemExit as exc:
                if kind == "replace":
                    raise SystemExit(f"{exc}\n{name} was removed and will be recreated on the next run") from None
                raise
        print(f"register-jobs: {kind} {name}")
    return 0


def main(argv=None, env=None, runner=_run):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--boot", action="store_true", help="never fail: called from cont-init")
    args = parser.parse_args(argv)
    try:
        if env is None:
            env = {**os.environ, **str_env.read_setup_env(pathlib.Path(os.environ.get("HERMES_HOME", "/var/lib/hermes")))}
        if not env.get("HOSTEX_TOKEN"):
            if args.boot:
                print("str: not set up yet -- jobs wait until HOSTEX_TOKEN is set")
                return 0
            raise SystemExit("register-jobs: str is not set up (no HOSTEX_TOKEN) -- refusing to remove jobs")
        return apply(env, runner)
    except (Exception, SystemExit) as exc:
        if not args.boot:
            raise
        print(f"str: {exc} (the boot carries on)", file=sys.stderr)
        return 0


if __name__ == "__main__":
    sys.exit(main())
