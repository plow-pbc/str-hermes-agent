#!/usr/bin/env python3
"""Hold str's wiki pages against the local ingest manifest.

The pages live on the owner's Mac and the manifest in the container, so this is
the one check that reads both. Every conversation a page cites must have a
manifest record: ingest-all's processed-set is the manifest, so a cited but
unrecorded conversation reads as never ingested, and the next nightly appends
its facts to a page that already holds them. The first compiled vault had nine
such citations.

Ported from the vault's own suite (tests/test_vault_integrity.py in the vault
repo), and only its provenance half. What a page must carry is `wiki validate`'s,
and index.md and every hub's operations table are generated by `wiki index`, so
there is no hand-kept inventory left to drift.

  wiki-provenance <staging vault> <wiki>

Prints one line per problem and exits 1 on any; exits 2 when the relay cannot
answer, so an unreachable Mac never reads as a clean corpus.
"""
from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import plow_relay

# The pages str's ingest writes, as `wiki index` lists them: its two roots and
# the standing cast. Other agents' people pages are not str's to hold here.
LISTED = re.compile(r"\]\(/(projects/str/(?:operations|properties)/[^)]+|entities/people/key-people)\.md\)")
# The scheme is captured on its own because the join is on the id alone: the
# 2026-08-04 regeneration wrote 392 citations as `tps://…`, which satisfied
# every id check while resolving nowhere.
CITED = re.compile(r"([A-Za-z]*:?/{0,2})hostex\.io/app/conversations/([\w-]+)")


def problems(wiki: str, manifest: dict) -> list[str]:
    recorded = {Path(key).stem for key in manifest["sources"]}
    listed = sorted(set(LISTED.findall(plow_relay.read(f"{wiki}/index.md"))))
    if not any(page.startswith("projects/str/operations/") for page in listed):
        return ["index.md lists no projects/str/operations pages, so every check here would pass on nothing"]
    found = []
    for page in listed:
        # Frontmatter only: a URL in the body is not provenance. A page with no
        # frontmatter raises here, and `wiki validate` names it.
        frontmatter = plow_relay.read(f"{wiki}/{page}.md").split("---", 2)[1]
        for scheme, conversation in sorted(set(CITED.findall(frontmatter))):
            if scheme != "https://":
                found.append(f"{page}: cites {conversation} with a truncated scheme {scheme!r}")
            if conversation not in recorded:
                found.append(f"{page}: cites {conversation}, which the manifest never recorded")
    return found


def main(argv: list[str] | None = None) -> int:
    vault, wiki = argv if argv is not None else sys.argv[1:]
    manifest = json.loads((Path(vault) / ".manifest.json").read_text())
    try:
        found = problems(wiki, manifest)
    except (plow_relay.RelayError, OSError) as e:
        print(f"wiki-provenance: {e}", file=sys.stderr)
        return 2
    for line in found:
        print(line)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main())
